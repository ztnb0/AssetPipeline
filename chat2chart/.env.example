# ---- chat2chart 后端配置（复制为 .env 后按需修改）----

# 后端服务端口
C2C_PORT=8787

# 最多同时运行的 opencode 任务数
C2C_MAX_CONCURRENT=2

# 单个任务超时（秒）
C2C_JOB_TIMEOUT=900

# 图表入场动画总时长（秒，用于录屏出视频时把展示节奏拉慢）
C2C_ANIM_SECONDS=8

# 图表入场动画结束后是否自动循环重播（1/true/yes/on 开启；前端每任务也可单独设置）
C2C_ANIM_LOOP=0

# Remotion 工程目录（默认 chat2chart/remotion，需先在该目录 npm install）
# C2C_REMOTION_DIR=

# Remotion 视频输出规格（默认 1080p@30fps）
# C2C_VIDEO_WIDTH=1920
# C2C_VIDEO_HEIGHT=1080
# C2C_VIDEO_FPS=30

# 最多同时运行的 Remotion 渲染任务数（渲染吃 CPU，默认 1）
# C2C_VIDEO_MAX_CONCURRENT=1

# 单次 Remotion 渲染超时（秒）
# C2C_RENDER_TIMEOUT=600

# opencode CLI 可执行文件（如已加入 PATH 可留空用默认 "opencode"）
# 例如：OPENCODE_BIN=C:\Users\me\AppData\Local\opencode\opencode.exe
OPENCODE_BIN=

# 可选：固定让 opencode 使用某个模型（provider/model），留空用 opencode 默认
C2C_MODEL=

# lieflat-charts 技能目录（默认自动探测 ~/.claude/skills/lieflat-charts）
# LIEFLAT_SKILL_PATH=

# 装有 akshare 的 Python 解释器（默认自动探测，含当前解释器与 pythoncore-3.11）
# AKSHARE_PYTHON=C:\Users\me\AppData\Local\Python\pythoncore-3.11-64\python.exe

# 任务数据存放目录（默认 chat2chart/data/jobs）
# C2C_DATA_DIR=
